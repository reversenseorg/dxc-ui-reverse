{
  "compileOnSave": false,
  "compilerOptions": {
    "module": "commonjs",
    "outDir": "./out-tsc",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "downlevelIteration": true,
    "target": "es5",
    "typeRoots": [
      "node_modules/@types"
    ],
    "lib": [
      "es2017",
      "es2016",
      "es2015",
      "dom"
    ]
  },
  "files": [
    "src/main.ts",
    "src/polyfills.ts"
  ],
  "include": [
    "main.ts",
    "WindowManager.ts",
    "src/**/*.d.ts",
    "src/**/*.ts",
    "**/*.spec.ts"
  ],
  "exclude": [
    "node_modules/**/*.ts",
    "src/app/**/*.spec.ts"
  ]
}
