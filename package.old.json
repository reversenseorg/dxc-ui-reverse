    "rimraf": "^3.0.2",
    "rxjs": "6.6.3",
    "spectron": "13.0.0",
    "ts-node": "9.1.0",
    "tslib": "2.0.3",
    "tslint": "~6.1.0",
    "typescript": "4.3.4",
    "wait-on": "6.0.0",
    "webdriver-manager": "12.1.7",
    "webpack-cli": "^4.8.0",
    "websocket": "^1.0.32",
    "zone.js": "0.11.4"
  },
  "dxcDependencies": {
    "adb": "1",
    "adb-server": "41",
    "java": "8",
    "r2": "2",
    "frida": "16",
    "python": "3",
    "pip": "3"
  },
  "engines": {
    "node": ">=10.13.0"
  },
  "browser": {
    "fs": false,
    "path": false,
    "os": false
  },
  "type": "commonjs"
}
