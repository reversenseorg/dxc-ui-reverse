{
  "name": "dexcalibur-ui",
  "productName": "DexcaliburPRO",
  "version": "1.0.0",
  "homepage": "https://www.reversense.com",
  "description": "Dexcalibur is a reverse engineering software for mobile application. Its main goal is to help security researchers to find vulnerability and malware analysts to identify malwares.",
  "author": {
    "name": "Georges-Bastien MICHEL",
    "email": "contact@reversense.com"
  },
  "scripts": {
    "ng": "ng",
    "lint": "ng lint",
    "start": "DXC_TMP_LOG=$HOME/dxc/dxc_tmp.log DXC_DEVMODE=1 npm-run-all -p prepare:dev electron:serve ng:serve",
    "cleanup:ui": "rm -f WindowManager.js WindowManager.js.map main.js main.js.map",
    "prepare:prod": "cp config/dxc.prod.json config/dxc.config.json",
    "prepare:dev": "cp config/dxc.dev.json config/dxc.config.json",
    "build": "npm run electron:serve-tsc && ng build --base-href ./",
    "build:dev": "npm run build -- -c dev",
    "build:prod": "npm run build -- -c production",
    "build:ui": "npm run cleanup:ui && npm run prepare:prod  && ./node_modules/.bin/tsc -p tsconfig.json && ng build  --base-href . --configuration production",
    "pack:osx": "electron-packager . --overwrite --platform=darwin --arch=x64 --icon=icons/mac/icon.icns --out=release-builds",
    "pack:darwin:x64": "electron-packager . --overwrite --platform=darwin --arch=x64 --icon=icons/mac/icon.icns --out=release-builds",
    "pack:darwin:arm64": "electron-packager . --overwrite --platform=darwin --arch=arm64 --icon=icons/mac/icon.icns --out=release-builds",
    "ng:serve": "ng serve -c web -o",
    "electron:serve-tsc": "./node_modules/.bin/tsc -p tsconfig.serve.json",
    "electron:serve": "wait-on tcp:4200 && npm run electron:serve-tsc && npx electron . --serve",
    "electron:local": "npm run build:prod && npx electron .",
    "electron:build": "npm run build:prod && electron-builder -c ./electron-builder.json build",
    "electron:build-ui": "npm run build:ui && electron-builder -c ./electron-builder.prod.json build",
    "electron:build-ui:arm64": "npm run build:ui && electron-builder -c ./electron-builder.prod.arm64.json build --arm64 ",
    "dxc-server:build": "npm run build:prod && electron-builder -c ./electron-builder.json build",
    "test": "ng test --watch=false",
    "test:ts": "rimraf ./out-tsc && ./node_modules/.bin/tsc -p ./tsconfig.test.json && DXC_TEST=1 npx jasmine-ts --config=./spec/.config/jasmine.json",
    "test:watch": "ng test",
    "e2e": "npm run build:prod && cross-env TS_NODE_PROJECT='e2e/tsconfig.e2e.json' mocha --timeout 300000 --require ts-node/register e2e/**/*.e2e.ts",
    "version": "conventional-changelog -i CHANGELOG.md -s -r 0 && git add CHANGELOG.md",
    "dist": "build"
  },
  "build": {
    "appId": "com.reversense.dxc",
    "productName": "DexcaliburPRO",
    "copyright": "Copyright © 2022 REVERSENSE SAS",
    "directories": {
      "buildResources": "build",
      "output": "dist",
      "app": "app"
    },
    "dmg": {
      "category": "public.app-category.developer-tools",
      "contents": [
        {
          "x": 110,
          "y": 150
        },
        {
          "x": 240,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "win": {
      "target": "NSIS",
      "icon": "build/icon.ico"
    }
  },
  "main": "main.js",
  "dependencies": {
    "@electron/remote": "^1.2.1",
    "adm-zip": "^0.4.16",
    "execa": "^6.0.0",
    "got": "^11.8.2",
    "semver": "^7.3.2",
    "sudo-prompt": "^9.2.1"
  },
  "devDependencies": {
    "@angular-builders/custom-webpack": "12.1.1",
    "@angular-devkit/build-angular": "12.2.3",
    "@angular-eslint/builder": "12.3.1",
    "@angular-eslint/eslint-plugin": "12.3.1",
    "@angular-eslint/eslint-plugin-template": "12.3.1",
    "@angular-eslint/schematics": "12.3.1",
    "@angular-eslint/template-parser": "12.3.1",
    "@angular/animations": "12.2.3",
    "@angular/cli": "^12.2.17",
    "@angular/common": "12.2.3",
    "@angular/compiler": "12.2.3",
    "@angular/compiler-cli": "12.2.3",
    "@angular/core": "12.2.3",
    "@angular/forms": "12.2.3",
    "@angular/language-service": "12.2.3",
    "@angular/localize": "12.2.3",
    "@angular/platform-browser": "12.2.3",
    "@angular/platform-browser-dynamic": "12.2.3",
    "@angular/router": "12.2.3",
    "@fortawesome/angular-fontawesome": "^0.9.0",
    "@fortawesome/fontawesome-svg-core": "^6.4.2",
    "@fortawesome/free-brands-svg-icons": "^6.1.1",
    "@fortawesome/pro-duotone-svg-icons": "^6.1.1",
    "@fortawesome/pro-light-svg-icons": "^6.1.1",
    "@fortawesome/pro-regular-svg-icons": "^6.1.1",
    "@fortawesome/pro-solid-svg-icons": "^6.1.1",
    "@ng-bootstrap/ng-bootstrap": "^10.0.0",
    "@ngx-translate/core": "13.0.0",
    "@ngx-translate/http-loader": "6.0.0",
    "@types/jasmine": "3.6.2",
    "@types/jasminewd2": "2.0.8",
    "@types/node": "14.14.33",
    "@types/proxyquire": "^1.3.28",
    "@typescript-eslint/eslint-plugin": "4.7.0",
    "@typescript-eslint/eslint-plugin-tslint": "4.7.0",
    "@typescript-eslint/parser": "4.7.0",
    "bootstrap": "^4.5.0",
    "chai": "4.2.0",
    "codelyzer": "^6.0.0",
    "conventional-changelog-cli": "2.1.1",
    "core-js": "3.6.5",
    "cross-env": "7.0.2",
    "electron": "^13.2.1",
    "electron-builder": "22.11.7",
    "electron-packager": "^15.2.0",
    "electron-rebuild": "^3.2.3",
    "electron-reload": "1.5.0",
